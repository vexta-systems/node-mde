    "test": "mocha",
    "types": "npx tsc"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vexta-systems/node-mde.git"
  },
  "keywords": [
    "nfe",
    "cte",
    "sefaz",
    "nota",
    "fiscal",
    "evento",
    "manifestacao",
