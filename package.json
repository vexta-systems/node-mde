  "author": "Lucas Melo <lucashpmelo94@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/@vexta-systems/node-mde/issues"
  },
  "homepage": "https://github.com/vexta-systems/node-mde#readme",
  "dependencies": {
    "axios": "^1.12.2",
    "fast-xml-parser": "^5.3.0",
    "luxon": "^3.7.2",
    "node-forge": "1.3.2",
    "xml-crypto": "^6.1.2"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.9.1",
    "@types/node-forge": "^1.3.14",
    "@types/xml-crypto": "^1.4.6",
    "mocha": "^11.7.4",
    "np": "^10.2.0",
    "typescript": "^5.9.3",
    "uglify-js": "^3.19.3"
